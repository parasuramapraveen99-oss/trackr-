# Copy to .env.local for local development.

# Server-side upstream for Plus's same-origin /api/trackr proxy. Production requires
# HTTPS. Set this when building/deploying; the browser never needs the upstream URL.
TRACKR_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL remains a compatibility fallback for older deployments.

# There is deliberately no NEXT_PUBLIC_INGEST_DOMAIN. It existed here for an illustrative
# example string that no component ever rendered -- nothing in trackr-frontend/ has ever
# read it. Every forwarding address the UI shows comes from the backend's account
# response (AccountOut.forwarding_addresses), because only the backend knows which
# (broker, doctype) pairs have a working parser. The frontend must never build one.
