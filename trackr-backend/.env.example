# trackr-backend/.env.example -- 12-factor configuration template.
#
# Copy to trackr-backend/.env for local development. Every name here is EXACT: these
# match what db/connection.py, db/crypto.py and storage/{local,s3}.py already read
# directly from the environment (unchanged by this move), so app/config.py's Settings
# sources from the same variables rather than inventing new ones. See
# docs/BACKEND_REUSE_AND_GAP_ANALYSIS.md section 4.
#
# None of these have safe defaults. A DEBUG=True fallback secret is exactly the kind of
# dummy value CLAUDE.md's Rule 1 forbids -- set real values here, the same as production.

# --- database -------------------------------------------------------------------
# Standard libpq URL. db/connection.py raises DatabaseNotConfiguredError rather than
# guessing at localhost if this is unset.
DATABASE_URL=postgresql://localhost/portfolio

# --- field-level encryption (db/crypto.py) ---------------------------------------
# Fernet key for PAN/demat ciphertext. Generate with:
#   python -c "from app.db.crypto import generate_key; print(generate_key())"
PORTFOLIO_ENCRYPTION_KEY=

# Pepper for the PAN lookup hash. A distinct secret from the key above -- deliberately,
# so a partial compromise (one secret leaked) does not defeat both encryption and lookup.
PORTFOLIO_PAN_PEPPER=

# --- auth -------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# --- ops endpoints (app/auth/ops.py) -----------------------------------------
# Shared secret for POST /ops/prices/refresh and /ops/snapshots/run, sent as the
# X-Ops-Key header. Unset means both endpoints refuse every request outright -- they
# are meant for a cron job or you, curling the box directly, never a logged-in user.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_API_KEY=

# --- web --------------------------------------------------------------------
# Comma-separated, and every origin listed explicitly -- these requests carry an
# Authorization header, so a wildcard is both refused by browsers and wrong in principle.
#
# TWO FRONTEND APPLICATIONS share this one backend (docs/PRODUCT_ARCHITECTURE.md):
#   :3000  trackr-frontend/            Trackr+
#   :3001  trackr-workspace-frontend/  Trackr Workspace
# In production these are the two deployed domains instead. See docs/DEPLOYMENT.md step 6.
#
# CORS IS NOT ACCESS CONTROL. Listing the Workspace origin here lets its pages read a
# response; it grants nobody the Workspace capability. Only `python -m
# app.db.grant_capability` does that, and a CLI with no Origin header at all gets the
# identical authorization decision.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEBUG=true

# --- free public reference reconciliation ------------------------------------
# No vendor key required. Same real sources in both DEBUG modes.
# start.sh starts the worker; production runs python -m app.reference_worker.
# Setup, deployment and coverage limits: docs/REFERENCE_SYNC_SETUP.md
REFERENCE_SYNC_ENABLED=true
REFERENCE_HTTP_TIMEOUT_SECONDS=20
REFERENCE_WORKER_POLL_SECONDS=30
REFERENCE_WORKER_BATCH_SIZE=5
REFERENCE_NSDL_MAX_PAGES=100

# --- document storage ---------------------------------------------------------
# "local" for development, "s3" for R2/S3-compatible production storage.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/documents
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
LOCAL_STORAGE_BASE_URL=http://localhost:8000/documents

# storage/local.py's signing secret for local-backend URLs (required only when
# STORAGE_BACKEND=local).
PORTFOLIO_STORAGE_SIGNING_SECRET=

# storage/s3.py's parameters (required only when STORAGE_BACKEND=s3, and validated at
# startup since migration 038's work -- an s3 backend with no bucket used to boot fine and
# fail on the first upload instead).
PORTFOLIO_STORAGE_BUCKET=
PORTFOLIO_STORAGE_ENDPOINT=
# R2/S3 CREDENTIALS ARE BOTO3'S OWN ENV VARS, NOT TRACKR-SPECIFIC ONES. app/storage/s3.py
# calls boto3.client("s3", endpoint_url=...) with no explicit keys, so they are resolved
# from boto3's default chain. Setting the bucket and endpoint WITHOUT these is the
# configuration that boots cleanly and then fails on the first PUT; GET /health/storage is
# what proves they actually resolve.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- price-pipe failure alerts (prices/alerts.py) --------------------------------
# Required only to send real alerts. When SMTP_HOST/SMTP_FROM_ADDRESS/SMTP_ALERT_RECIPIENT
# are unset, app.prices.alerts.get_notifier() falls back to log-only delivery -- the price
# pipe still runs, it just does not reach a human on failure. See docs/INGESTION.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
# Only needed if your SMTP relay requires auth (most hosted providers do).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_ALERT_RECIPIENT=

# --- inbound-email forwarding addresses (app/ingest/addresses.py) ---------------
# Not a secret -- this is the domain mailed to clients as their forwarding address,
# e.g. c001-zerodha-contractnote@<this domain>. Only safe to leave unset while
# DEBUG=true above: app/config.py's _validate_ingest_domain fails at startup if this
# is still the dev placeholder outside DEBUG mode, rather than silently handing out
# addresses at a domain that bounces mail.
#
# A BARE HOSTNAME, and use a SUBDOMAIN. No scheme, no trailing slash, no port -- the
# value is interpolated straight into a client-facing address, and `https://example.com/`
# used to be accepted and produce `c001-zerodha-contractnote@https://example.com/`. MX
# records belong on `ingest.yourdomain.com`, never the apex, or the provider starts
# receiving all mail for your brand domain.
#
# The frontend has no equivalent variable and needs none: every address it shows comes
# from this backend's account response.
INGEST_DOMAIN=

# THE EMAIL FORWARDING SWITCH: true or false. Off by default while its architecture is
# reworked. Off = no forwarding address is shown anywhere, the Gmail setup step and icon
# are hidden, POST /ingest/email refuses every delivery (406), and INGEST_DOMAIN is not
# required. Uploading files on the Import page works either way.
EMAIL_FORWARDING_ENABLED=false
# Emergency stop for automatic TRADE promotion; receipt and staging continue.
# A live investor mandate and strict identity/parse checks are still required when true.
EMAIL_AUTO_PROMOTE_ENABLED=true

# --- inbound-email webhook (app/ingest/webhook_providers.py) --------------------
# POST /ingest/email is internet-facing: one of "mailgun", "postmark", "sendgrid".
# Unset means the endpoint refuses every request rather than guessing a provider.
# Only the secret(s) for the chosen provider need a value -- app/config.py validates
# the combination at startup, so choosing a provider without its secret fails at boot,
# not on the first real webhook.
INGEST_WEBHOOK_PROVIDER=

# Mailgun: hmac_sha256(signing_key, timestamp + token) checked against the posted
# `signature` form field.
INGEST_MAILGUN_SIGNING_KEY=

# Postmark: no payload signature -- HTTP Basic Auth on the Authorization header
# instead. Set these to whatever you configure in Postmark's inbound webhook settings.
INGEST_POSTMARK_BASIC_AUTH_USER=
INGEST_POSTMARK_BASIC_AUTH_PASSWORD=

# SendGrid: no payload signature either. Inbound Parse has no custom-header support,
# so the shared secret travels as the Basic Auth password -- configure SendGrid's
# webhook URL as https://<secret>:x@<INGEST_DOMAIN above>/ingest/email and it arrives
# as a standard Authorization header.
INGEST_SENDGRID_SHARED_SECRET=

# Reject an oversized request (413) before base64-decoding it into memory. Defaults to
# 25 MiB, Mailgun's own combined-attachment cap.
INGEST_MAX_ATTACHMENT_BYTES=26214400
# Bound the temporary encrypted Postgres backlog per investor. Full = retryable 503.
# The worker archives delivery sources and clears their encrypted DB payloads.
INGEST_MAX_SPOOLED_BYTES_PER_INVESTOR=67108864
# How many attachments ONE inbound message may carry. Gmail's bulk "Forward as attachment"
# is bounded by its page size of 100 conversations, so this is that plus headroom.
# Mailgun intake preserves/acknowledges the bounded delivery; the worker retains its
# original and reports an explicit extraction-limit outcome instead of dropping it.
INGEST_MAX_ATTACHMENTS_PER_DELIVERY=150


# --- LLM-assisted document extraction (app/ai/llm.py, app/ingest/llm_*.py) ---------
# Structures broker documents no deterministic parser handles: the LLM transcribes,
# and app/ingest/llm_verify.py proves every number against the document before a row is
# staged. Rows scored CONFIDENCE_UNCERTAIN (0.5) CANNOT be promoted to the ledger
# without an explicit acknowledgement -- app/db/imports.py::promote_batch.
#
# Only redacted text ever leaves this process: an allow-list keeps lines carrying an
# ISIN, a deny-list masks anything PAN/UCC/email/phone-shaped among the survivors, and
# a fail-closed assertion refuses to send at all if either missed something. A document
# with no ISIN-bearing lines is never sent anywhere. See app/ingest/redaction.py.
#
# COMPLIANCE: enabling this makes OpenRouter a fourth Data Processor. Do NOT set
# LLM_PARSING_ENABLED=true in production before the DPA is signed and the MITC AI-usage
# clause is in the advisory agreement. Both are open gates in docs/COMPLIANCE.md.
# A key present with the flag false is the normal state -- turning the feature off must
# never require deleting the key.
LLM_PARSING_ENABLED=false

# Key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Swappable by env alone -- any OpenRouter model id works, so trying another is a config
# change, not a code change. Must support response_format={"type": "json_object"} (check
# supported_parameters at https://openrouter.ai/api/v1/models). The default is free and has
# the largest context (512K) of the JSON-capable free models. Alternatives:
#   google/gemma-4-31b-it:free           (262K, least crowded; upstream-throttled at times)
#   nvidia/nemotron-3-super-120b-a12b:free (262K, larger model, more crowded)
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

CRON_SECRET=

# --- grounded analytics narration (app/narrative/, app/routers/narrative.py) -----
# A THIRD, SEPARATE PERMISSION. LLM_PARSING_ENABLED grants transmitting the contents of
# client DOCUMENTS for extraction. This grants transmitting an investor's DERIVED
# POSITIONS -- names, ISINs, quantities and rupee amounts -- so a model can write the
# analytics page's explanations and answer questions in the assistant. Same vendor, same
# key, different processing purpose, and DPDP consent is per purpose rather than per
# vendor. docs/COMPLIANCE.md gates it on the same signed DPA plus an MITC clause that
# covers this second use.
#
# With it false the analytics page renders every figure exactly as before, with no
# generated prose, and the assistant returns 503. That is the NORMAL state.
INSIGHT_GENERATION_ENABLED=false

# --- Ask about markets (app/market_assistant/, docs/AI_ASSISTANT_PRIVACY_PLAN.md) ---
# Trackr+'s public-only assistant. No portfolio access. Without per-request opt-in,
# only the local concept library is available and no external calls are made.
# Off by default: the drawer then says the assistant is turned off.
PUBLIC_RESEARCH_ENABLED=false

# Opted-in safe questions are classified/planned by the LLM, then searched through Exa.
# At most two searches: trusted public publishers, then wider issuer discovery. Unknown
# issuer sites require an explicit official website reference. Its own key separates
# assistant spend from background research. Daily ceilings are shared in Postgres;
# missing counters fail closed. Unset key or limit 0 disables searching.
MARKET_ASSISTANT_EXA_API_KEY=
MARKET_ASSISTANT_SEARCH_DAILY_LIMIT=50

# A pinned free LLM checks finance relevance before search and writes a short answer
# from admitted evidence. Exact support, citations, numbers and claim checks are required;
# doubtful prose falls back to attributed quotes. ONE pinned model ID
# ending ":free" (startup fails otherwise). Requests ask for providers that do not collect
# prompts and forbid fallbacks; a free model offered only by providers that train on
# prompts is refused (404) and ranked excerpts are shown instead. Without OpenRouter
# credits the free tier allows only a small number of requests a day (HTTP 429 after).
MARKET_ASSISTANT_OPENROUTER_API_KEY=
MARKET_ASSISTANT_MODEL=
MARKET_ASSISTANT_MODEL_DAILY_LIMIT=50
# Messages per signed-in login per India calendar day (migration 085).
# Independent of the shared provider-call ceilings above; the drawer shows remaining.
MARKET_ASSISTANT_MESSAGE_DAILY_LIMIT=20
# Phase 5 passage ranking: lexical (default) | bm25 | hybrid. hybrid needs the optional
# extra `assistant-embeddings` and the model fetched once into the cache dir by
# scripts/fetch_market_assistant_embedding_model.py; without it, hybrid runs as bm25.
# On the 11 Oct 2026 evaluation hybrid did NOT beat lexical, so lexical stays the default.
MARKET_ASSISTANT_RETRIEVAL=lexical
MARKET_ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MARKET_ASSISTANT_EMBEDDING_CACHE_DIR=

# --- fast semantic classification (app/ai/jev.py, app/ingest/corporate_action_feed.py) --
# Attributes a multi-amount/multi-kind NSE dividend notice ("Interim Dividend Rs 1.50 Per
# Share And Special Dividend Rs 2 Per Share") that the parser's own regex can read but
# cannot pair. PUBLIC-DATA-ONLY, unlike OPENROUTER_API_KEY above: only the NSE subject line,
# ISIN and symbol are sent -- a company-wide announcement, never an investor's own data --
# so this carries no DPA gate and no LLM_PARSING_ENABLED-style flag. Unset means those
# notices are refused exactly as they always were: no candidate, not a guess.
JEV_API_KEY=

JEV_MODEL=jev-latest

# --- migration identity (app/db/migrate.py) ---------------------------------------
# The connection SCHEMA CHANGES run through, which is deliberately not the connection
# requests run through. Whoever applies a migration OWNS the tables it creates, and a
# table owner can drop the append-only triggers that make those tables append-only. So
# the web process must not be the schema owner.
#
# Unset is supported and is what a single-role dev Postgres does; start.sh prints that it
# fell back rather than falling back silently. It stops being optional the moment
# WORKSPACE_ENABLED=true, because that is when unguarded research tables become reachable.
MIGRATION_DATABASE_URL=

# --- Trackr Workspace database identities (app/db/connection.py) -------------------
# OFF, and not a beta flag: research routes do not exist yet. Even once they do, this flag
# alone cannot turn them on -- app/db/migrate.py::assert_workspace_ready also requires the
# complete 040–045 migration bundle to be recorded as applied, because a flag that could
# expose a half-built schema (tables from 040–043, tenant RLS from 045 missing) would be
# worse than no flag.
WORKSPACE_ENABLED=false

# SIX SEPARATE LOGINS, ONE PER CAPABILITY. Provision them with
# scripts/provision_workspace_roles.sql, then set a password on each out of band; the
# script deliberately sets none, so a half-finished provisioning cannot authenticate.
#
# POINTING TWO OF THESE AT ONE LOGIN SILENTLY DELETES A GUARD, which is why Settings
# refuses it at startup. Every actor check in migration 044 asks PostgreSQL who is
# connected -- ws_human() is pg_has_role(current_user,'trackr_ws_human','member') -- so if
# the runner and human DSNs share a login, the untrusted browser-result submission path IS
# a human reviewer as far as the database is concerned and can accept its own output.
#
# All six fail CLOSED when unset. There is no fallback to MIGRATION_DATABASE_URL or
# DATABASE_URL: an unconfigured eraser must refuse to erase, not erase as the schema owner
# with RLS bypassed and every trigger droppable.
WORKSPACE_HUMAN_DATABASE_URL=
WORKSPACE_RUNNER_DATABASE_URL=
WORKSPACE_ENGINE_DATABASE_URL=
WORKSPACE_SCHEDULER_DATABASE_URL=
WORKSPACE_READER_DATABASE_URL=
WORKSPACE_ERASER_DATABASE_URL=
