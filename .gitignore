.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.DS_Store

# OAuth grants and client secrets for the Gmail adapter. Developer-local, never committed.
client_secret*.json
gmail.json
*.token.json

# ---------------------------------------------------------------------------
# CLIENT DATA NEVER ENTERS VERSION CONTROL.
#
# Statements, contract notes, tradebooks and CAS files are one person's financial
# history. Under DPDP they must be erasable on request, and git history is the one
# place data cannot be erased from -- a force-push does not reach anyone who has
# already cloned. They live in object storage with a retention policy instead.
# ---------------------------------------------------------------------------
*.pdf
*.xlsx
*.xls
*.csv
# Archives are the one shape the rule above misses: a zipped folder of the same
# statements/contract notes has none of the extensions above and was found sitting
# untracked and un-ignored in docs/ during the pre-deployment audit (2026-08-30).
*.zip

# The golden fixture is REAL: every trade, date, quantity and price one investor has
# made, plus their demat identifiers. It is the correctness bar for the engine and it
# stays local. tests/test_golden_portfolio.py skips without it, and the local path is
# named in that module's docstring.
fixtures/golden_portfolio.json

# Anything dropped into the repo for a one-off local run.
local/
scratch/
*.local.*

# Synthetic and public fixtures are safe and DO belong in the repo -- re-admitted
# below, deliberately and one at a time rather than with a blanket !fixtures/** :
#   engine_cases.json           hand-computed unit cases, no real data
#   bhavcopy/*.csv               public end-of-day exchange prices
#   nse_sector_sample.csv        trimmed real rows from NSE's public Industry classification
#   amfi_market_cap_sample.xlsx  trimmed real rows from AMFI's public large/mid/small-cap list
!fixtures/engine_cases.json
!fixtures/bhavcopy/
!fixtures/bhavcopy/*.csv
!fixtures/nse_sector_sample.csv
!fixtures/amfi_market_cap_sample.xlsx

# Connection strings with real credentials. DATABASE_URL is read from the environment
# (db/connection.py refuses to guess one), and a .env holding a production URL is the
# most likely way a password reaches git history -- where it cannot be erased.
.env
.env.*
# The template is safe and belongs in the repo: names and comments only, every value
# blank. Re-admitted explicitly, same pattern as the fixtures exceptions below.
!.env.example
!**/.env.example

# trackr-frontend/ (Next.js)
trackr-frontend/node_modules/
trackr-frontend/.next/

# The second frontend application, and the npm-workspaces root. `node_modules/` at the
# root is where npm hoists shared dependencies once the workspaces are installed; the
# two apps keep their own only for anything that cannot hoist.
node_modules/
trackr-workspace-frontend/node_modules/
trackr-workspace-frontend/.next/
packages/*/node_modules/
trackr-frontend/out/
trackr-frontend/next-env.d.ts
trackr-frontend/*.tsbuildinfo

# start.sh / stop.sh runtime state (PIDs and logs, written at repo root)
.trackr-pids/
.trackr-logs/

# Design-tool scratch exports dropped at repo root -- not app code, never committed.
/Trackr+ Design System*/
/Trackr+ Standalone.html
/.next/

# TypeScript incremental build cache -- regenerated by every typecheck/build.
*.tsbuildinfo
